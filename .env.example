# Translations (French): python3 scripts/build_fr_django_po.py && msgfmt -o locale/fr/LC_MESSAGES/django.mo locale/fr/LC_MESSAGES/django.po
#
# Development .env (minimal — SQLite needs no DATABASE_URL)
SECRET_KEY=any-long-random-string-for-local-dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LANGUAGE_CODE=fr-FR
TIME_ZONE=Africa/Abidjan

# Railway production (set in the Railway dashboard, not in git)
# DJANGO_SETTINGS_MODULE is optional: wsgi uses prod when RAILWAY_ENVIRONMENT is set.
# SECRET_KEY=<generate a long random string>
# DATABASE_URL=<added automatically when you attach Railway Postgres>
# ALLOWED_HOSTS=.up.railway.app,your-service.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://your-service.up.railway.app
# CORS_ALLOWED_ORIGINS=https://your-service.up.railway.app
# Optional: SENTRY_DSN=...
#
# API (JWT): POST /api/token/ with {"username","password"} — see /api/schema/swagger/
#
# SMS (Africa's Talking): set username + apiKey; put E.164 phone on the district supervisor User
# AFRICASTALKING_USERNAME=...
# AFRICASTALKING_API_KEY=...